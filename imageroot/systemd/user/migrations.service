#
# Run the Infisical database migrations to completion before the app starts.
#
[Unit]
Description=Infisical database migrations
BindsTo=infisical.service
Requires=postgresql-app.service
After=infisical.service redis-app.service postgresql-app.service

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
TimeoutStartSec=900
ExecStart=/usr/bin/podman run --rm --name migrations \
    --pod-id-file %t/infisical.pod-id \
    --env-file=%E/state/app.env \
    --env-file=%E/state/secrets.env \
    --workdir /backend \
    ${INFISICAL_IMAGE} npm run migration:latest
SyslogIdentifier=%u

[Install]
WantedBy=default.target
